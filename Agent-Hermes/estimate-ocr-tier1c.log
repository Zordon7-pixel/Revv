+          },
+        },
+      },
+    })
+
+    const { container } = render(<EstimateImportWizard onClose={vi.fn()} onImported={vi.fn()} />)
+
+    fireEvent.change(container.querySelector('input[type="file"]'), {
+      target: { files: [new File(['pdf'], 'ccc-estimate.pdf', { type: 'application/pdf' })] },
