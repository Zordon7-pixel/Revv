+    assert.ok(inserts.some((call) => /INSERT INTO vehicles/i.test(call.sql) && call.params[1] === 'shop-1'));
+    assert.ok(inserts.some((call) => /INSERT INTO repair_orders/i.test(call.sql) && call.params[1] === 'shop-1'));
+
