  const summary = await getEstimateSummaryForRo(roId, shopId, queryOne);
  const profit = calculateProfit({ ...current, ...summary });
  await queryRun(
    `UPDATE repair_orders
     SET parts_cost = $1,
         labor_cost = $2,
         sublet_cost = $3,
         tax = $4,
         total = $5,
         estimate_amount = $6,
         true_profit = $7,
         updated_at = NOW()
     WHERE id = $8 AND shop_id = $9`,
    [
      summary.parts_cost,
      summary.labor_cost,
      summary.sublet_cost,
      summary.tax,
      summary.total,
      summary.total,
      normalizeMoney(profit?.trueProfit, 0),
      roId,
      shopId,
    ]
  );
  return summary;
}

