+            deductible_waived: 0,
+            referral_fee: 0,
+            goodwill_repair_cost: 0,
+          }],
+        };
+      }
+      if (/COALESCE\(SUM\(total\)/i.test(sql)) {
+        return {
+          rows: [{
+            subtotal: 892.95,
