const emptyForm = {
  customer_name: '',
  customer_phone: '',
  vehicle_year: '',
  vehicle_make: '',
  vehicle_model: '',
  vin: '',
  insurance_company: '',
  claim_number: '',
  adjuster_name: '',
  adjuster_phone: '',
  adjuster_email: '',
  deductible: '',
